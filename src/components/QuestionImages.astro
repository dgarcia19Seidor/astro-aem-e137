---
import type { QuestionImage } from "../data/exams";

interface Props {
  images?: QuestionImage[];
}

const { images = [] } = Astro.props;
---

{images.length > 0 && (
  <div class="my-3 space-y-3">
    {images.map((image) => (
      <a href={image.src} target="_blank" rel="noopener noreferrer" class="block" aria-label={`${image.alt}. Abrir imagen a tamaño completo`}>
        <img src={image.src} alt={image.alt} loading="lazy" class="h-auto max-w-full rounded-lg border border-slate-300 bg-white" />
      </a>
    ))}
  </div>
)}
